# --- Mercado Pago ---

# Access Token de la cuenta MP que recibe los pagos
# Obtenerlo en: developers.mercadopago.com → Tus integraciones → cuenta personal
MP_ACCESS_TOKEN=reemplazar_con_token_mp

# --- Validación de destinatario ---

# CUIT o CUIL de quien debe aparecer como receptor en el comprobante
# Formato: XX-XXXXXXXX-X  (ej: 20-12345678-3)
# Si el OCR no detecta el CUIT en la imagen, este chequeo se omite (no bloquea)
CUIT_DESTINATARIO=XX-XXXXXXXX-X

# --- Base de datos ---

# DSN de PostgreSQL
# Para desarrollo local con docker-compose.yml incluido:
DATABASE_URL=postgresql://validador:validador_dev@localhost:5433/validador

# --- Aplicación ---

# Identificador del tenant para esta instalación
TENANT_ID=nombre_empresa

# Clave secreta que el frontend envía en el header X-API-Key
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=reemplazar_con_clave_segura

# Palabras clave OCR para validar comprobantes (opcional — tiene default razonable)
# KEYWORDS_OCR=$,monto,importe,total,transferencia,acreditado,pago

# --- Autenticación de admins ---

# Clave secreta para firmar los JWT de admins. NUNCA compartir ni subir a git.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=reemplazar_con_clave_secreta_jwt

# Algoritmo de firma JWT (HS256 es el estándar y suficiente para este caso)
# JWT_ALGORITHM=HS256

# False en dev local (HTTP). Poner en true en Railway (HTTPS).
# Con Secure=True el browser solo envía la cookie en conexiones HTTPS.
SECURE_COOKIES=false

# --- Observabilidad ---

# DSN de Sentry para captura de errores en producción.
# Obtenerlo en: sentry.io → tu proyecto → Settings → Client Keys (DSN)
# Dejar vacío en desarrollo local.
SENTRY_DSN=

# --- Rate limiting ---

# Límite de intentos de login por IP por minuto.
# Formato slowapi: "5/minute", "10/minute", etc.
# Por defecto: 5/minute (no hace falta definirlo si querés el default)
# RATE_LIMIT_LOGIN=5/minute

# --- Cloudflare R2 ---

# ID de cuenta de Cloudflare (visible en la URL del dashboard: dash.cloudflare.com/{ACCOUNT_ID})
R2_ACCOUNT_ID=reemplazar_con_account_id

# Credenciales del API Token R2 (crear en R2 → Manage R2 API Tokens → Create API Token)
R2_ACCESS_KEY_ID=reemplazar_con_access_key_id
R2_SECRET_ACCESS_KEY=reemplazar_con_secret_access_key

# Nombre exacto del bucket creado en R2
R2_BUCKET_NAME=validador-comprobantes

# --- WhatsApp (Meta Cloud API) ---

# Token de acceso al número de WhatsApp Business.
# En Meta for Developers: App → WhatsApp → API Setup → "Temporary access token" (24h)
# Para producción: crear un System User con token permanente.
WHATSAPP_TOKEN=reemplazar_con_token_meta

# ID numérico del número de teléfono registrado en Meta (no es el número en sí).
# En Meta for Developers: App → WhatsApp → API Setup → "Phone Number ID"
WHATSAPP_PHONE_NUMBER_ID=reemplazar_con_phone_number_id

# String secreto que elegís vos para verificar el webhook al configurarlo en Meta.
# Meta lo envía en el primer request GET al webhook — debe coincidir exactamente.
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
WHATSAPP_VERIFY_TOKEN=reemplazar_con_verify_token_secreto

# App Secret de Meta — para validar la firma HMAC-SHA256 de cada mensaje entrante.
# En Meta for Developers: App → Settings → Basic → "App secret"
# ⚠️ OBLIGATORIO en producción — sin este valor el webhook acepta mensajes sin verificar origen.
# Dejar vacío solo en dev local (sandbox).
WHATSAPP_APP_SECRET=reemplazar_con_app_secret

# --- Redis ---

# URL de conexión a Redis (Upstash en Railway, o redis://localhost:6379 en local)
# Vacío en dev local → usa fakeredis en memoria (pub/sub funciona dentro del proceso)
REDIS_URL=

# --- Vision LLM — Gemini ---
# SDK: google-genai (NO google-generativeai, deprecado desde 11/2025)
# Obtener API key gratuita: https://aistudio.google.com/apikey
# Free tier: 1.500 requests/día de Gemini Flash — suficiente para desarrollo y piloto
# Si está vacío, el sistema cae automáticamente a Tesseract (no falla)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Desactivar LLM sin redesplegar — útil si hay problemas de API en producción
LLM_HABILITADO=true

# Timeouts canal WhatsApp — Meta tiene límite duro de 20s para responder el webhook
# Peor caso con estos valores: 5s (LLM) + 8s (Tesseract) = 13s. Margen de 7s.
LLM_TIMEOUT_WHATSAPP_SEGUNDOS=5
LLM_REINTENTOS_WHATSAPP=1
TESSERACT_TIMEOUT_WHATSAPP_SEGUNDOS=8

# Timeouts carga manual — corre en background, sin límite de tiempo percibido
LLM_TIMEOUT_MANUAL_SEGUNDOS=30
LLM_REINTENTOS_MANUAL=2
TESSERACT_TIMEOUT_MANUAL_SEGUNDOS=12
